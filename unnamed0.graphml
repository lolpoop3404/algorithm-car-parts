	return rand() % (max - min + 1) + min

function rand_str(*str, length)
char *charset = ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789

for(int i = 0; i &lt; length - 1) DO
	str[i] == charset[rand() % strlen(charset)]
endfor

