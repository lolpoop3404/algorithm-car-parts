int n1 = mid - left + 1
int n2 = right - mid

for(int i = 0; i &lt; n1) DO 
	for(int j = 0; j &lt;n2) DO
		left[i] = arr[left + i]
			right[j] = arr[mid + 1 + j]
	endfor
endfor

